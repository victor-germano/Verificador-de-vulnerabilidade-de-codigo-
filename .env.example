# Copy this file to .env and adjust values before running docker-compose
# or the backend locally.

# --- App ---
ENVIRONMENT=development
DEBUG=false

# --- Database ---
# Used as-is by docker-compose's postgres service; override if you point
# at a different Postgres instance.
DATABASE_URL=postgresql+asyncpg://sast:sast@localhost:5432/sast

# --- Security ---
# Generate a strong random value for production, e.g.: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please

# --- CORS ---
# JSON array of allowed frontend origins.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- AI (optional) ---
# Leave unset to keep AI features disabled (endpoints respond 501). Set
# both to enable explain/suggest-fix/summarize via the Anthropic API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
